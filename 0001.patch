+def assert_golden(test, name, actual):
+    path = GOLDEN / name
+    actual = _normalize_text(actual)
+    if UPDATE:
+        path.parent.mkdir(parents=True, exist_ok=True)
+        path.write_text(actual, encoding='utf-8', newline='\n')
